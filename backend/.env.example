# DeepSeek (OpenAI-compatible). Leave empty to disable AI features.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Optional proxy for overseas platforms, e.g. http://127.0.0.1:7890
YTDLP_PROXY=

MAX_WORKERS=3
FILE_TTL_MINUTES=30
MAX_FILESIZE_MB=1024
MAX_BATCH=20

# Video-to-text: ONLY this Beijing DashScope Key is required. No OSS account needed.
DASHSCOPE_API_KEY=

# Optional overrides. These defaults work with only the Key above.
ASR_PROVIDER=fun-asr-flash
ASR_MODEL=fun-asr-flash-2026-06-15
DASHSCOPE_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
ASR_WORKERS=2
ASR_SEGMENT_WORKERS=2
ASR_MAX_QUEUE=20
# Hard ceiling for one recognition; plans set their own lower limits (free 8 / monthly 30 / yearly 60 minutes).
ASR_MAX_DURATION=3600
ASR_MAX_FILESIZE_MB=100
ASR_DAILY_BUDGET=10
ASR_PRICE_PER_SECOND=0.00022
ASR_TIMEOUT=180
ASR_RATE_LIMIT=10
# Production: a stable random value >=32 characters, HTTPS and Secure cookies.
SESSION_SECRET=
SESSION_SECURE=false
# Comma-separated exact browser origins when behind a reverse proxy.
ALLOWED_ORIGINS=
# Accounts (MySQL 8.x). Create databases with backend/sql/schema.sql; tables are also created on startup.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=freevideo
# Separate database used only by pytest (tables are truncated); leave empty to skip account tests.
MYSQL_TEST_DATABASE=freevideo_test
AUTH_SESSION_DAYS=7
# Per-IP limits: registrations per 10 minutes, login attempts per minute.
AUTH_REGISTER_RATE_LIMIT=5
AUTH_LOGIN_RATE_LIMIT=10
# Require an emailed link before registration is complete. Configure SMTP first.
AUTH_EMAIL_VERIFICATION_REQUIRED=false
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_SSL=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Online payment via ZPAY (Alipay). See docs/zpay-setup.md. Empty PID/KEY = payment disabled.
ZPAY_PID=
# The merchant KEY is a password: never commit it or send it to the browser.
ZPAY_KEY=
ZPAY_GATEWAY=https://zpayz.cn
# Public address of this site, used for notify_url (/api/pay/notify) and return_url (/pay/result).
# Local dev without public IP: http://127.0.0.1:8000 (payments are confirmed by order query instead of notify).
PUBLIC_BASE_URL=http://127.0.0.1:8000
# true = local fake cashier, no money involved (ignored when SESSION_SECURE=true).
ZPAY_MOCK=false
PAYMENT_ORDER_TTL_MINUTES=30
# Background order-query interval in seconds; 0 disables it.
PAYMENT_RECONCILE_SECONDS=60
# Optional absolute executable paths if not on PATH.
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
# Optional state directory, outside DOWNLOAD_DIR; persist across restarts.
# ASR_DIR=

# Optional legacy file-ASR adapter (not needed for the default key-only mode).
# ASR_PROVIDER=paraformer
# ASR_MODEL=paraformer-v2
# ASR_PRICE_PER_SECOND=0.00008
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
# OSS_REGION=cn-beijing
# OSS_BUCKET=
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_SECURITY_TOKEN=
# ASR_POLL_SECONDS=3
# OSS_URL_TTL=7200
