{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Frontend build",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"frontend",
				"run",
				"build"
			],
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "FreeVideo local server",
			"type": "shell",
			"command": "backend/.venv/Scripts/python",
			"args": [
				"-m",
				"uvicorn",
				"app.main:app",
				"--app-dir",
				"backend",
				"--host",
				"127.0.0.1",
				"--port",
				"8000",
				"--no-proxy-headers"
			],
			"isBackground": true,
			"problemMatcher": []
		}
	]
}