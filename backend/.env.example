# DeepSeek (OpenAI-compatible). Leave empty to disable AI features.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Optional proxy for overseas platforms, e.g. http://127.0.0.1:7890
YTDLP_PROXY=

MAX_WORKERS=3
FILE_TTL_MINUTES=30
MAX_FILESIZE_MB=1024
MAX_BATCH=20

# Video-to-text: ONLY this Beijing DashScope Key is required. No OSS account needed.
DASHSCOPE_API_KEY=

# Optional overrides. These defaults work with only the Key above.
ASR_PROVIDER=fun-asr-flash
ASR_MODEL=fun-asr-flash-2026-06-15
DASHSCOPE_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
ASR_WORKERS=2
ASR_SEGMENT_WORKERS=2
ASR_MAX_QUEUE=20
ASR_MAX_DURATION=3600
ASR_MAX_FILESIZE_MB=100
ASR_DAILY_BUDGET=10
ASR_PRICE_PER_SECOND=0.00022
ASR_TIMEOUT=180
ASR_RATE_LIMIT=10
# Production: a stable random value >=32 characters, HTTPS and Secure cookies.
SESSION_SECRET=
SESSION_SECURE=false
# Comma-separated exact browser origins when behind a reverse proxy.
ALLOWED_ORIGINS=
# Optional absolute executable paths if not on PATH.
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
# Optional state directory, outside DOWNLOAD_DIR; persist across restarts.
# ASR_DIR=

# Optional legacy file-ASR adapter (not needed for the default key-only mode).
# ASR_PROVIDER=paraformer
# ASR_MODEL=paraformer-v2
# ASR_PRICE_PER_SECOND=0.00008
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
# OSS_REGION=cn-beijing
# OSS_BUCKET=
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_SECURITY_TOKEN=
# ASR_POLL_SECONDS=3
# OSS_URL_TTL=7200
